# yTrader secret template — SAFE TO COMMIT (dummy values only).
# Copy to `.env` (gitignored, never commit that file) and fill in:
#   Copy-Item .env.example .env   # PowerShell
#
# Real environment variables always win over `.env` entries, so
# CI/prod secret injection keeps working unchanged.

# OANDA practice token (https://www.oanda.com → practice account → token).
# Required for mode = "live" (practice host only). Never put the live key here.
OANDA_API_KEY=paste-practice-token-here

# Anthropic key for LLM strategies + LLM router brain. Optional: agents
# needing it are skipped with a message when absent; everything else runs.
ANTHROPIC_API_KEY=

# License key placeholder for P2-3. Unused today (seam only).
TRADING_LICENSE_KEY=
